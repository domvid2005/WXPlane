# Writes OUT (a C file) holding the UI fonts and the radar basemap as byte arrays: wx_font_<name>[] and wx_font_<name>_size.
# Run with: cmake -DSRC=<third_party/fonts> -DOUT=<file.c> -P embed_fonts.cmake
set(names plex_regular plex_semibold plex_bold mono basemap logo)
set(files IBMPlexSans-Regular.ttf IBMPlexSans-SemiBold.ttf IBMPlexSans-Bold.ttf JetBrainsMono-Regular.ttf ../basemap/basemap.bin ../../assets/wxplane_logo.png)
set(body "/* generated by cmake/embed_fonts.cmake - do not edit */\n")
list(LENGTH names n)
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
  list(GET names ${i} name)
  list(GET files ${i} file)
  file(READ "${SRC}/${file}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
  string(APPEND body "const unsigned char wx_font_${name}[] = {\n${bytes}\n};\nconst unsigned int wx_font_${name}_size = ${size};\n")
endforeach()
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
